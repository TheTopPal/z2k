#!/bin/sh
export PATH=/opt/sbin:/opt/bin:/sbin:/usr/sbin:/bin:/usr/bin

# /opt/etc/init.d/S97z2k-http-tunnel
#
# Spins up a second tg-mtproxy-client instance on :1444 and iptables-redirects
# specific HTTP/80 destinations through it. Coexists with S98tg-tunnel
# (which owns :1443 and the Telegram CIDRs) — different listen port, different
# CIDR list, separate PID file.
#
# Installed by lib/install.sh from files/init.d/S97z2k-http-tunnel.
# Companion NDM hook /opt/etc/ndm/netfilter.d/91-z2k-http-tunnel-redirect.sh
# re-inserts these REDIRECT rules after every NDM-driven netfilter regen
# (WAN flap, tunnel up/down, hotplug, reboot).

BIN="/opt/sbin/tg-mtproxy-client"
LOG="/tmp/z2k-log/z2k-http-tunnel.log"
# CWE-59: root-owned 0700 log dir
# CWE-59: /tmp/z2k-log должен быть чистым root-owned каталогом. symlink /
# не-каталог / чужой владелец = возможная подмена атакующим (с planted
# symlink'ами внутри) → снести и создать заново. busybox `stat -c` нет —
# владельца берём из `ls -ld`.
if [ -L /tmp/z2k-log ] || { [ -e /tmp/z2k-log ] && [ ! -d /tmp/z2k-log ]; } || \
   { [ -d /tmp/z2k-log ] && [ "$(ls -ld /tmp/z2k-log 2>/dev/null | awk '{print $3}')" != root ]; }; then
    rm -rf /tmp/z2k-log 2>/dev/null
fi
mkdir -p /tmp/z2k-log 2>/dev/null && chown root /tmp/z2k-log 2>/dev/null
chmod 700 /tmp/z2k-log 2>/dev/null
PIDFILE="/var/run/z2k-http-tunnel.pid"
LISTEN_PORT="1444"

CIDRS="168.119.95.238/32"

# Тот же приём, что у соседа S96z2k-rt-proxy: правила ставим под блокировкой
# xtables. Без -w две службы, стартующие одновременно (а они и стартуют — S96,
# S97, S98 идут подряд, и NDM в это же время перестраивает свои цепочки),
# получают "another app is currently holding the xtables lock" и молча уходят в
# 2>/dev/null: правило не встало, туннель не работает, в логе пусто.
#
# Откат на вызов без -w обязателен: флаг понимают не все сборки BusyBox, и
# жёсткое -w сломало бы перенаправление там, где раньше оно работало.
ipt() { iptables -w "$@" 2>/dev/null || iptables "$@" 2>/dev/null; }

start() {
    # ПУСТЫШКА С 07.09.2026. Порт :1444 обслуживает тот же процесс, что и :1443,
    # его поднимает S98tg-tunnel. Здесь ничего не запускается намеренно: второй
    # процесс на том же бинарнике давал только вторую сессию к релею и второго
    # надзирателя без сторожа. Файл оставлен, потому что на него ссылаются
    # установщик, апдейтер, панель и сторож, — и потому что его `stop` нужен
    # для перехода: он добивает прежний экземпляр, оставшийся в памяти.
    [ -x "$BIN" ] || exit 0
    if [ -f "/opt/zapret2/config" ]; then
        user_disabled=$(awk -F= '/^TG_PROXY_USER_DISABLED=/ {gsub(/[" ]/,"",$2); print $2; exit}' /opt/zapret2/config)
        if [ "$user_disabled" = "1" ]; then
            echo "z2k-http-tunnel disabled by user — skipping autostart"
            return 0
        fi
    fi
    echo "z2k-http-tunnel: порт :$LISTEN_PORT обслуживает S98tg-tunnel, отдельный процесс не нужен"
    return 0
}

stop() {
    echo "Stopping z2k-http-tunnel (legacy)..."
    # Прежний надзиратель — по pidfile, а если pidfile потерян — по cmdline и
    # ppid=1: сирота переживала stop и поднимала демон обратно.
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    for _pd in /proc/[0-9]*; do
        p="${_pd#/proc/}"
        [ "$p" = "$$" ] && continue
        [ -r "$_pd/cmdline" ] || continue
        tr '\0' ' ' < "$_pd/cmdline" 2>/dev/null | grep -q "S97z2k-http-tunnel" || continue
        [ "$(awk '/^PPid:/{print $2}' "$_pd/status" 2>/dev/null)" = "1" ] || continue
        kill "$p" 2>/dev/null
    done
    # Демон только с нашим портом — это ПРЕЖНИЙ отдельный процесс. Новый
    # слушает и :1443, и его трогать нельзя: он принадлежит S98.
    if pidof tg-mtproxy-client >/dev/null 2>&1; then
        for p in $(pidof tg-mtproxy-client); do
            if [ -r "/proc/$p/cmdline" ] && \
               tr '\0' ' ' < "/proc/$p/cmdline" | grep -q -- "--listen=:$LISTEN_PORT" && \
               ! tr '\0' ' ' < "/proc/$p/cmdline" | grep -q -- "--listen=:1443"; then
                kill "$p" 2>/dev/null
            fi
        done
    fi
    # Правила редиректа теперь принадлежат S98 — здесь их не трогаем.
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop ;;
    *) echo "Usage: $0 {start|stop|restart}" ;;
esac
